# ---- Frontend (Vite exposes these to the browser — safe, public values only) ----
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Backend only (set these in Vercel Project Settings > Environment Variables,
#      NEVER put them in VITE_* vars, never commit real values) ----
ANTHROPIC_API_KEY=sk-ant-your-real-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Weekly parent digest (backend only) ----
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=Moujahid <digest@yourdomain.com>
# Any long random string — Vercel Cron sends it automatically as a Bearer
# token, and the digest function checks it before running. Generate one
# with: openssl rand -hex 32
CRON_SECRET=a-long-random-string
